<script>
/* ================= STATE ================= */
let sb = null;
let recipes = [];
let activeCategory = "すべて";
let searchQuery = "";
let selectedIds = new Set();
let editingId = null;
let pendingImageFile = null;

const ACCENTS = ["#c1502e", "#7a8b5a", "#d9a441", "#4a7a78", "#8b5a6b"];
const TILTS = [-1.4, 0.8, -0.6, 1.2, -1.8, 0.4];

/* ================= INIT ================= */
function initSupabase(){
  if (SUPABASE_URL === "YOUR_SUPABASE_URL" || SUPABASE_ANON_KEY === "YOUR_SUPABASE_ANON_KEY") {
    document.getElementById("configNotice").classList.remove("hidden");
    return false;
  }
  const { createClient } = window.supabase;
  sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  return true;
}

function hashColor(str){
  let h = 0;
  for (let i = 0; i < (str || "").length; i++) h = (h * 31 + str.charCodeAt(i)) >>> 0;
  return ACCENTS[h % ACCENTS.length];
}
function hashTilt(id){
  let h = 0;
  for (let i = 0; i < (id || "").length; i++) h = (h * 17 + id.charCodeAt(i)) >>> 0;
  return TILTS[h % TILTS.length];
}
function escapeHtml(str){
  return (str ?? "").toString()
    .replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;")
    .replaceAll('"',"&quot;");
}
function showToast(msg, isError=false){
  const t = document.getElementById("toast");
  if (t) t.remove();
  const div = document.createElement("div");
  div.id = "toast";
  div.className = isError ? "error" : "";
  div.textContent = msg;
  document.body.appendChild(div);
  setTimeout(() => { div.style.opacity = "0"; setTimeout(() => div.remove(), 300); }, 2400);
}

/* ================= DATA LOAD ================= */
async function loadRecipes(){
  if (!sb) return;
  const { data, error } = await sb.from("recipes").select("*").order("created_at", { ascending: false });
  if (error) { showToast("読み込みに失敗しました: " + error.message, true); return; }
  recipes = data || [];
  renderCategoryChips();
  renderGrid();
}

function renderCategoryChips(){
  const wrap = document.getElementById("categoryChips");
  const cats = ["すべて", ...new Set(recipes.map(r => r.category).filter(Boolean))];
  wrap.innerHTML = cats.map(c =>
    `<button class="chip ${c === activeCategory ? "active" : ""}" data-cat="${escapeHtml(c)}">${escapeHtml(c)}</button>`
  ).join("");
  wrap.querySelectorAll(".chip").forEach(btn => {
    btn.addEventListener("click", () => {
      activeCategory = btn.dataset.cat;
      renderCategoryChips();
      renderGrid();
    });
  });
  // datalist for form
  const dl = document.getElementById("categoryList");
  dl.innerHTML = [...new Set(recipes.map(r => r.category).filter(Boolean))]
    .map(c => `<option value="${escapeHtml(c)}">`).join("");
}

function getFiltered(){
  const q = searchQuery.trim().toLowerCase();
  return recipes.filter(r => {
    if (activeCategory !== "すべて" && r.category !== activeCategory) return false;
    if (!q) return true;
    const inTitle = (r.title || "").toLowerCase().includes(q);
    const inTags = (r.tags || []).some(t => t.toLowerCase().includes(q));
    const inIng = (r.ingredients || []).some(i => (i.name || "").toLowerCase().includes(q));
    return inTitle || inTags || inIng;
  });
}

/* ================= RENDER GRID ================= */
function renderGrid(){
  const list = getFiltered();
  const grid = document.getElementById("recipeGrid");
  const empty = document.getElementById("emptyState");

  if (list.length === 0) {
    grid.innerHTML = "";
    empty.classList.remove("hidden");
    return;
  }
  empty.classList.add("hidden");

  grid.innerHTML = list.map(r => {
    const tilt = hashTilt(r.id);
    const tapeColor = hashColor(r.category || r.title);
    const thumb = r.image_url
      ? `<img class="thumb" src="${escapeHtml(r.image_url)}" alt="${escapeHtml(r.title)}">`
      : `<div class="thumb-fallback">🍽️</div>`;
    const tags = (r.tags || []).slice(0, 4).map(t => `<span class="tag">#${escapeHtml(t)}</span>`).join("");
    const checked = selectedIds.has(r.id) ? "checked" : "";
    return `
      <div class="card" style="--tilt:${tilt}deg" data-id="${r.id}">
        <div class="tape" style="background:${tapeColor}"></div>
        ${thumb}
        <div class="card-body">
          <h3>${escapeHtml(r.title)}</h3>
          <div class="card-meta">
            ${r.category ? `<span>${escapeHtml(r.category)}</span>` : ""}
            ${r.cook_time ? `<span>⏱ ${r.cook_time}分</span>` : ""}
            ${r.servings ? `<span>👥 ${r.servings}人分</span>` : ""}
          </div>
          <div class="card-tags">${tags}</div>
          <div class="card-actions">
            <label class="select-box" onclick="event.stopPropagation()">
              <input type="checkbox" class="select-cb" data-id="${r.id}" ${checked}> リストに追加
            </label>
            <div>
              <button class="icon-btn edit-btn" data-id="${r.id}" title="編集" onclick="event.stopPropagation()">✏️</button>
              <button class="icon-btn del-btn" data-id="${r.id}" title="削除" onclick="event.stopPropagation()">🗑️</button>
            </div>
          </div>
        </div>
      </div>`;
  }).join("");

  grid.querySelectorAll(".card").forEach(card => {
    card.addEventListener("click", () => openDetail(card.dataset.id));
  });
  grid.querySelectorAll(".select-cb").forEach(cb => {
    cb.addEventListener("change", () => {
      if (cb.checked) selectedIds.add(cb.dataset.id); else selectedIds.delete(cb.dataset.id);
      updateFloatBar();
    });
  });
  grid.querySelectorAll(".edit-btn").forEach(b => {
    b.addEventListener("click", () => openForm(b.dataset.id));
  });
  grid.querySelectorAll(".del-btn").forEach(b => {
    b.addEventListener("click", () => deleteRecipe(b.dataset.id));
  });
}

function updateFloatBar(){
  const bar = document.getElementById("floatBar");
  document.getElementById("selectCount").textContent = `${selectedIds.size}件選択中`;
  bar.classList.toggle("hidden", selectedIds.size === 0);
}

/* ================= FORM MODAL (追加/編集) ================= */
function ingredientRowHtml(name="", amount="", unit=""){
  return `
    <div class="ing-row">
      <input type="text" class="ing-name" placeholder="材料名" value="${escapeHtml(name)}">
      <input type="text" class="ing-amount" placeholder="分量" value="${escapeHtml(amount)}">
      <input type="text" class="ing-unit" placeholder="単位" value="${escapeHtml(unit)}">
      <button type="button" class="remove-row" aria-label="この行を削除">✕</button>
    </div>`;
}

function addIngredientRow(name="", amount="", unit=""){
  const wrap = document.getElementById("ingredientRows");
  const div = document.createElement("div");
  div.innerHTML = ingredientRowHtml(name, amount, unit);
  const row = div.firstElementChild;
  row.querySelector(".remove-row").addEventListener("click", () => row.remove());
  wrap.appendChild(row);
}

function openForm(id=null){
  editingId = id;
  pendingImageFile = null;
  document.getElementById("recipeForm").reset();
  document.getElementById("ingredientRows").innerHTML = "";
  document.getElementById("imgPreview").classList.add("hidden");
  document.getElementById("imgPreview").src = "";

  if (id) {
    const r = recipes.find(x => x.id === id);
    document.getElementById("formTitle").textContent = "レシピを編集";
    document.getElementById("recipeId").value = r.id;
    document.getElementById("titleInput").value = r.title || "";
    document.getElementById("categoryInput").value = r.category || "";
    document.getElementById("tagsInput").value = (r.tags || []).join(", ");
    document.getElementById("servingsInput").value = r.servings || "";
    document.getElementById("cookTimeInput").value = r.cook_time || "";
    document.getElementById("stepsInput").value = (r.steps || []).join("\n");
    (r.ingredients || []).forEach(i => addIngredientRow(i.name, i.amount, i.unit));
    if (r.image_url) {
      const img = document.getElementById("imgPreview");
      img.src = r.image_url;
      img.classList.remove("hidden");
    }
  } else {
    document.getElementById("formTitle").textContent = "新しいレシピ";
    document.getElementById("recipeId").value = "";
    addIngredientRow();
  }
  document.getElementById("formOverlay").classList.remove("hidden");
}

function closeForm(){
  document.getElementById("formOverlay").classList.add("hidden");
}

async function uploadImage(file){
  const ext = file.name.split(".").pop();
  const path = `${crypto.randomUUID()}.${ext}`;
  const { error } = await sb.storage.from(BUCKET_NAME).upload(path, file, { upsert: false });
  if (error) throw error;
  const { data } = sb.storage.from(BUCKET_NAME).getPublicUrl(path);
  return data.publicUrl;
}

async function saveRecipe(e){
  e.preventDefault();
  if (!sb) { showToast("Supabaseが未設定です", true); return; }

  const saveBtn = document.getElementById("saveBtn");
  saveBtn.disabled = true;
  saveBtn.textContent = "保存中...";

  try {
    const ingredients = [...document.querySelectorAll("#ingredientRows .ing-row")]
      .map(row => ({
        name: row.querySelector(".ing-name").value.trim(),
        amount: row.querySelector(".ing-amount").value.trim(),
        unit: row.querySelector(".ing-unit").value.trim(),
      }))
      .filter(i => i.name);

    const steps = document.getElementById("stepsInput").value
      .split("\n").map(s => s.trim()).filter(Boolean);

    const tags = document.getElementById("tagsInput").value
      .split(",").map(t => t.trim()).filter(Boolean);

    const payload = {
      title: document.getElementById("titleInput").value.trim(),
      category: document.getElementById("categoryInput").value.trim() || null,
      tags,
      servings: Number(document.getElementById("servingsInput").value) || null,
      cook_time: Number(document.getElementById("cookTimeInput").value) || null,
      ingredients,
      steps,
    };

    if (pendingImageFile) {
      payload.image_url = await uploadImage(pendingImageFile);
    }

    const id = document.getElementById("recipeId").value;
    if (id) {
      const { error } = await sb.from("recipes").update(payload).eq("id", id);
      if (error) throw error;
      showToast("更新しました");
    } else {
      const { error } = await sb.from("recipes").insert(payload);
      if (error) throw error;
      showToast("登録しました");
    }
    closeForm();
    await loadRecipes();
  } catch (err) {
    showToast("保存に失敗しました: " + err.message, true);
  } finally {
    saveBtn.disabled = false;
    saveBtn.textContent = "保存する";
  }
}

async function deleteRecipe(id){
  if (!confirm("このレシピを削除しますか？")) return;
  const { error } = await sb.from("recipes").delete().eq("id", id);
  if (error) { showToast("削除に失敗しました: " + error.message, true); return; }
  selectedIds.delete(id);
  showToast("削除しました");
  document.getElementById("detailOverlay").classList.add("hidden");
  updateFloatBar();
  await loadRecipes();
}

/* ================= 詳細モーダル ================= */
function openDetail(id){
  const r = recipes.find(x => x.id === id);
  if (!r) return;
  const img = r.image_url ? `<img class="detail-img" src="${escapeHtml(r.image_url)}" alt="${escapeHtml(r.title)}">` : "";
  const ing = (r.ingredients || []).map(i =>
    `<li><span>${escapeHtml(i.name)}</span><span>${escapeHtml(i.amount)} ${escapeHtml(i.unit)}</span></li>`
  ).join("");
  const steps = (r.steps || []).map(s => `<li>${escapeHtml(s)}</li>`).join("");
  const tags = (r.tags || []).map(t => `<span class="tag">#${escapeHtml(t)}</span>`).join(" ");

  document.getElementById("detailContent").innerHTML = `
    ${img}
    <h2>${escapeHtml(r.title)}</h2>
    <div class="detail-meta">
      ${r.category ? `<span>${escapeHtml(r.category)}</span>` : ""}
      ${r.cook_time ? `<span>⏱ ${r.cook_time}分</span>` : ""}
      ${r.servings ? `<span>👥 ${r.servings}人分</span>` : ""}
    </div>
    <div class="card-tags">${tags}</div>
    <div class="detail-section">
      <h4>材料</h4>
      <ul class="ing-list">${ing || "<li>未登録</li>"}</ul>
    </div>
    <div class="detail-section">
      <h4>作り方</h4>
      <ol class="steps-list">${steps || "<li>未登録</li>"}</ol>
    </div>
  `;
  document.getElementById("editFromDetailBtn").dataset.id = r.id;
  document.getElementById("deleteFromDetailBtn").dataset.id = r.id;
  document.getElementById("detailOverlay").classList.remove("hidden");
}

/* ================= 買い物リスト ================= */
function openShoppingList(){
  const list = [];
  selectedIds.forEach(id => {
    const r = recipes.find(x => x.id === id);
    if (r) (r.ingredients || []).forEach(i => list.push(i));
  });

  const merged = {};
  list.forEach(i => {
    const key = (i.name || "").trim().toLowerCase() + "|" + (i.unit || "").trim().toLowerCase();
    const amountNum = parseFloat(i.amount);
    if (!merged[key]) {
      merged[key] = { name: i.name, unit: i.unit, amounts: [], numericSum: 0, hasNumeric: false };
    }
    if (!isNaN(amountNum) && /^[\d.]+$/.test((i.amount || "").trim())) {
      merged[key].numericSum += amountNum;
      merged[key].hasNumeric = true;
    } else if (i.amount) {
      merged[key].amounts.push(i.amount);
    }
  });

  const items = Object.values(merged).map(m => {
    const parts = [];
    if (m.hasNumeric) parts.push(String(m.numericSum));
    parts.push(...m.amounts);
    const amountText = parts.length ? parts.join(" + ") : "";
    return `${m.name} ${amountText} ${m.unit || ""}`.trim();
  });

  const ul = document.getElementById("shopList");
  ul.innerHTML = items.length
    ? items.map((text, idx) =>
        `<li data-idx="${idx}"><input type="checkbox" class="shop-cb"><span>${escapeHtml(text)}</span></li>`
      ).join("")
    : `<li>選択したレシピに材料が登録されていません</li>`;

  ul.querySelectorAll(".shop-cb").forEach(cb => {
    cb.addEventListener("change", () => cb.closest("li").classList.toggle("checked", cb.checked));
  });

  document.getElementById("shopOverlay").classList.remove("hidden");
}

function copyShoppingList(){
  const items = [...document.querySelectorAll("#shopList li span")].map(s => s.textContent);
  navigator.clipboard.writeText(items.join("\n"))
    .then(() => showToast("コピーしました"))
    .catch(() => showToast("コピーに失敗しました", true));
}

/* ================= イベント登録 ================= */
document.getElementById("searchInput").addEventListener("input", (e) => {
  searchQuery = e.target.value;
  renderGrid();
});
document.getElementById("newRecipeBtn").addEventListener("click", () => openForm(null));
document.getElementById("closeFormBtn").addEventListener("click", closeForm);
document.getElementById("cancelFormBtn").addEventListener("click", closeForm);
document.getElementById("recipeForm").addEventListener("submit", saveRecipe);
document.getElementById("addIngredientBtn").addEventListener("click", () => addIngredientRow());

document.getElementById("imageInput").addEventListener("change", (e) => {
  const file = e.target.files[0];
  if (!file) return;
  pendingImageFile = file;
  const reader = new FileReader();
  reader.onload = (ev) => {
    const img = document.getElementById("imgPreview");
    img.src = ev.target.result;
    img.classList.remove("hidden");
  };
  reader.readAsDataURL(file);
});

document.getElementById("closeDetailBtn").addEventListener("click", () =>
  document.getElementById("detailOverlay").classList.add("hidden"));
document.getElementById("editFromDetailBtn").addEventListener("click", (e) => {
  document.getElementById("detailOverlay").classList.add("hidden");
  openForm(e.target.dataset.id);
});
document.getElementById("deleteFromDetailBtn").addEventListener("click", (e) =>
  deleteRecipe(e.target.dataset.id));

document.getElementById("clearSelectBtn").addEventListener("click", () => {
  selectedIds.clear();
  updateFloatBar();
  renderGrid();
});
document.getElementById("makeShopBtn").addEventListener("click", openShoppingList);
document.getElementById("closeShopBtn").addEventListener("click", () =>
  document.getElementById("shopOverlay").classList.add("hidden"));
document.getElementById("copyShopBtn").addEventListener("click", copyShoppingList);
document.getElementById("printShopBtn").addEventListener("click", () => window.print());

[document.getElementById("formOverlay"), document.getElementById("detailOverlay"), document.getElementById("shopOverlay")]
  .forEach(overlay => {
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) overlay.classList.add("hidden");
    });
  });

/* ================= 起動 ================= */
(function start(){
  const ok = initSupabase();
  if (ok) loadRecipes();
})();
</script>
