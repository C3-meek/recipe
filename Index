<!-- 構造：<!DOCTYPE html> 〜 </html> まで。CONFIG(Supabase設定) → STYLE → BODY(ヘッダー/フィルター/カード一覧/3つのモーダル) → SCRIPT(データ取得・CRUD・検索・買い物リスト) -->
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>レシピ帳</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Yomogi&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  /* ============ トークン ============ */
  :root{
    --bg:#2b2620;
    --bg-soft:#332c23;
    --card:#f4ecd8;
    --card-edge:#e3d7ba;
    --ink:#2b2620;
    --chalk:#f2e9d8;
    --chalk-dim:#cabfa8;
    --tomato:#c1502e;
    --basil:#7a8b5a;
    --mustard:#d9a441;
    --teal:#4a7a78;
    --plum:#8b5a6b;
    --line:rgba(242,233,216,.14);
    --shadow:0 10px 24px rgba(0,0,0,.35);
    --radius:3px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(ellipse at 20% -10%, rgba(255,255,255,.03), transparent 40%),
      repeating-linear-gradient(0deg, rgba(255,255,255,.015) 0 1px, transparent 1px 3px),
      var(--bg);
    color:var(--chalk);
    font-family:'Zen Kaku Gothic New', sans-serif;
    min-height:100vh;
    padding-bottom:80px;
  }
  h1,h2,h3,.hand{font-family:'Yomogi', cursive;}
  a{color:inherit;}
  button{font-family:inherit;cursor:pointer;}
  .hidden{display:none !important;}

  /* ============ ヘッダー ============ */
  header{
    padding:36px 24px 20px;
    max-width:1100px;
    margin:0 auto;
  }
  header h1{
    font-size:2.4rem;
    margin:0 0 4px;
    color:var(--chalk);
    letter-spacing:.02em;
  }
  header h1 .egg{color:var(--mustard);}
  header p.sub{margin:0 0 22px;color:var(--chalk-dim);font-size:.92rem;}

  .toolbar{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    align-items:center;
  }
  .search-wrap{
    position:relative;
    flex:1 1 280px;
  }
  .search-wrap input{
    width:100%;
    padding:12px 14px 12px 38px;
    border-radius:var(--radius);
    border:1px solid var(--line);
    background:var(--bg-soft);
    color:var(--chalk);
    font-size:.95rem;
  }
  .search-wrap input::placeholder{color:var(--chalk-dim);}
  .search-wrap svg{
    position:absolute;left:12px;top:50%;transform:translateY(-50%);
    width:16px;height:16px;stroke:var(--chalk-dim);
  }
  .btn{
    border:none;
    border-radius:var(--radius);
    padding:12px 18px;
    font-weight:700;
    font-size:.92rem;
    background:var(--tomato);
    color:var(--chalk);
    transition:transform .12s ease, filter .12s ease;
  }
  .btn:hover{filter:brightness(1.08);}
  .btn:active{transform:scale(.97);}
  .btn.secondary{background:var(--bg-soft);border:1px solid var(--line);}
  .btn.ghost{background:transparent;border:1px solid var(--line);color:var(--chalk-dim);}
  .btn:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible{
    outline:2px solid var(--mustard); outline-offset:2px;
  }

  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;}
  .chip{
    padding:6px 13px;
    border-radius:999px;
    font-size:.82rem;
    border:1px solid var(--line);
    color:var(--chalk-dim);
    background:transparent;
  }
  .chip.active{background:var(--mustard);color:var(--ink);border-color:var(--mustard);font-weight:700;}

  /* ============ カード一覧 ============ */
  main{max-width:1100px;margin:0 auto;padding:8px 24px 24px;}
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(240px,1fr));
    gap:22px;
    margin-top:20px;
  }
  .card{
    position:relative;
    background:var(--card);
    color:var(--ink);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    overflow:hidden;
    cursor:pointer;
    transform:rotate(var(--tilt,0deg));
    transition:transform .15s ease, box-shadow .15s ease;
    border:1px solid var(--card-edge);
  }
  .card:hover{transform:rotate(0deg) translateY(-3px);box-shadow:0 16px 30px rgba(0,0,0,.4);}
  .tape{
    position:absolute;top:-6px;left:20px;
    width:64px;height:22px;
    opacity:.9;
    transform:rotate(-3deg);
    border-radius:1px;
  }
  .card .thumb{
    width:100%;height:130px;object-fit:cover;
    background:#ded2b3;
    display:block;
  }
  .thumb-fallback{
    width:100%;height:130px;
    display:flex;align-items:center;justify-content:center;
    font-size:2rem;background:#ded2b3;
  }
  .card-body{padding:14px 16px 16px;}
  .card-body h3{margin:2px 0 6px;font-size:1.15rem;line-height:1.3;}
  .card-meta{display:flex;gap:10px;font-size:.78rem;color:#6b6250;margin-bottom:8px;}
  .card-tags{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:10px;}
  .tag{font-size:.7rem;padding:3px 8px;border-radius:999px;background:rgba(43,38,32,.08);color:#4a4436;}
  .card-actions{display:flex;justify-content:space-between;align-items:center;}
  .select-box{display:flex;align-items:center;gap:6px;font-size:.78rem;color:#6b6250;}
  .icon-btn{
    background:transparent;border:none;padding:6px;border-radius:4px;color:#6b6250;
  }
  .icon-btn:hover{background:rgba(43,38,32,.08);}

  .empty{
    text-align:center;padding:60px 20px;color:var(--chalk-dim);
  }
  .empty h3{font-size:1.4rem;margin-bottom:6px;color:var(--chalk);}

  /* ============ 選択中バー(買い物リスト) ============ */
  .float-bar{
    position:fixed;left:50%;bottom:22px;transform:translateX(-50%);
    background:var(--bg-soft);
    border:1px solid var(--line);
    color:var(--chalk);
    padding:12px 16px;border-radius:999px;
    display:flex;align-items:center;gap:14px;
    box-shadow:var(--shadow);
    z-index:40;
  }

  /* ============ モーダル共通 ============ */
  .overlay{
    position:fixed;inset:0;background:rgba(20,17,13,.65);
    display:flex;align-items:flex-start;justify-content:center;
    padding:40px 16px;overflow-y:auto;z-index:100;
  }
  .modal{
    background:var(--card);color:var(--ink);
    width:100%;max-width:620px;border-radius:6px;
    box-shadow:var(--shadow);padding:26px 26px 24px;
  }
  .modal h2{margin:0 0 18px;font-size:1.6rem;}
  .modal-close{
    float:right;background:none;border:none;font-size:1.3rem;color:#6b6250;
  }
  .field{margin-bottom:14px;}
  .field label{display:block;font-size:.8rem;font-weight:700;color:#54503f;margin-bottom:5px;}
  .field input[type=text], .field input[type=number], .field select, .field textarea{
    width:100%;padding:9px 10px;border:1px solid var(--card-edge);border-radius:4px;
    font-family:inherit;font-size:.92rem;background:#fffdf7;color:var(--ink);
  }
  .field textarea{resize:vertical;min-height:90px;}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
  .ing-row{display:grid;grid-template-columns:1fr 90px 70px 30px;gap:8px;margin-bottom:8px;align-items:center;}
  .ing-row input{padding:8px 9px;border:1px solid var(--card-edge);border-radius:4px;font-size:.88rem;}
  .remove-row{background:none;border:none;color:var(--tomato);font-size:1.1rem;}
  .add-row-btn{font-size:.82rem;color:var(--teal);background:none;border:1px dashed var(--teal);padding:7px 12px;border-radius:4px;}
  .img-preview{width:100%;max-height:160px;object-fit:cover;border-radius:4px;margin-top:8px;display:none;}
  .modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;}
  .danger-btn{background:var(--tomato);color:#fff;}

  /* 詳細モーダル */
  .detail-img{width:100%;max-height:240px;object-fit:cover;border-radius:5px;margin-bottom:14px;}
  .detail-meta{display:flex;gap:16px;color:#6b6250;font-size:.85rem;margin-bottom:12px;}
  .detail-section h4{margin:16px 0 6px;font-size:.95rem;color:#54503f;}
  .steps-list{padding-left:20px;}
  .steps-list li{margin-bottom:8px;line-height:1.5;}
  .ing-list{list-style:none;padding:0;}
  .ing-list li{padding:6px 0;border-bottom:1px dashed var(--card-edge);display:flex;justify-content:space-between;font-size:.92rem;}

  /* 買い物リストモーダル */
  .shop-list{list-style:none;padding:0;margin:0 0 16px;}
  .shop-list li{
    display:flex;align-items:center;gap:10px;padding:9px 4px;border-bottom:1px dashed var(--card-edge);
    font-size:.94rem;
  }
  .shop-list li.checked span{text-decoration:line-through;color:#9a9280;}

  /* toast */
  #toast{
    position:fixed;top:20px;left:50%;transform:translateX(-50%);
    background:var(--basil);color:#fff;padding:11px 20px;border-radius:6px;
    font-size:.88rem;box-shadow:var(--shadow);z-index:200;transition:opacity .25s ease;
  }
  #toast.error{background:var(--tomato);}

  #configNotice{
    max-width:1100px;margin:16px auto 0;padding:14px 18px;background:var(--bg-soft);
    border:1px solid var(--mustard);border-radius:6px;color:var(--chalk-dim);font-size:.85rem;
    line-height:1.6;
  }
  #configNotice code{background:rgba(255,255,255,.08);padding:1px 5px;border-radius:3px;}

  @media (max-width:520px){
    .row2,.row3{grid-template-columns:1fr;}
    .ing-row{grid-template-columns:1fr 1fr 1fr;}
  }
</style>
</head>
